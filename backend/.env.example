# Bez żadnej konfiguracji aplikacja działa lokalnie w trybie dev (MemoryStore, bez Azure).

# Tryb: "dev" (domyślny; lokalnie i w testach) albo "prod" (wdrożenie).
# Poza "dev" — oraz zawsze, gdy ustawiony jest COSMOS_ENDPOINT — aplikacja NIE wystartuje
# z domyślnym/krótkim SESSION_SECRET, a konta urzędników nie powstaną z domyślnym hasłem.
ENV=dev

# Cosmos DB (zostaw puste, aby używać MemoryStore)
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=mrodzina
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]

# Podpis tokenów sesji. Na produkcji: losowy, min. 32 znaki, np.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-secret-change-me
SESSION_TTL_HOURS=12

# Hasło początkowe kont urzędników (seed tworzy tylko brakujące konta, nigdy nie nadpisuje haseł).
# Na produkcji (ENV != dev lub ustawiony COSMOS_ENDPOINT) hasło musi mieć min. 12 znaków i różnić się
# od "demo1234" — inaczej konta urzędników nie zostaną utworzone, a istniejące konta z hasłem "demo1234"
# zostaną wyłączone (flaga `disabled`, logowanie zwraca 401).
OFFICIAL_DEFAULT_PASSWORD=demo1234

# --- AI (plan 02) ---
# Bez AZURE_OPENAI_ENDPOINT i AZURE_OPENAI_API_KEY działa DemoLLM (odpowiedzi kanoniczne, offline).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# Endpoint zasobu Azure AI Foundry, np. https://<zasób>.cognitiveservices.azure.com/ (lub *.openai.azure.com)
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-nano
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Modele z rozumowaniem (gpt-5.x): minimal | low | medium | high. Puste dla gpt-4o-mini / gpt-4.1-nano.
AZURE_OPENAI_REASONING_EFFORT=low
# Maks. tokenów odpowiedzi na jedno wywołanie modelu.
AI_MAX_OUTPUT_TOKENS=1500

# Limity zapytań AI (spec §14). Limiter działa w pamięci procesu (per replika).
AI_USER_RPM=20
AI_USER_DAILY=300
AI_IP_RPM=60
AI_IP_DAILY=1000
# Dzienny budżet tokenów całej aplikacji (reset o północy Europe/Warsaw, zapis w kolekcji ai_usage).
AI_DAILY_TOKENS=500000
AI_MAX_INPUT_CHARS=8000
# Rezerwacja tokenów budżetu na jedno żądanie AI (rozliczana po odpowiedzi) i limit równoległych żądań AI.
AI_RESERVE_TOKENS=4000
AI_MAX_INFLIGHT=20
# Ile zaufanych proxy stoi przed aplikacją. 0 = X-Forwarded-For ignorowany (IP = adres połączenia).
# N>0 = IP to N-ty wpis X-Forwarded-For liczony od PRAWEJ. Azure Container Apps ingress: 1.
TRUST_PROXY_HOPS=0

# --- Czat (plan 06) ---
# Wyszukiwarka dla narzędzia szukaj_w_sieci: none (domyślnie, czat mówi że nie ma dostępu do sieci) | brave | serper.
WEB_SEARCH_PROVIDER=none
WEB_SEARCH_API_KEY=
# Poczta testowa (plan 09): opóźnienie predefiniowanych odpowiedzi urzędów (s) i cykl sprawdzania poczty (s, 0 = wyłączony)
MAIL_SIM_REPLY_DELAY_S=20
MAIL_POLL_S=30

# --- Tryb jaskółki (plan 10) ---
# Ile dni od zgłoszenia straty dziecka rodzic może je cofnąć. Po tym czasie zostaje ręczne „Wróć do zwykłego widoku”.
UNDO_WINDOW_DAYS=7
