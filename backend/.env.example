# Bez żadnej konfiguracji aplikacja działa lokalnie w trybie dev (MemoryStore, bez Azure).

# Tryb: "dev" (domyślny; lokalnie i w testach) albo "prod" (wdrożenie).
# Poza "dev" — oraz zawsze, gdy ustawiony jest COSMOS_ENDPOINT — aplikacja NIE wystartuje
# z domyślnym/krótkim SESSION_SECRET, a konta urzędników nie powstaną z domyślnym hasłem.
ENV=dev

# Cosmos DB (zostaw puste, aby używać MemoryStore)
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=mrodzina
CORS_ORIGINS=["http://localhost:5173"]

# Podpis tokenów sesji. Na produkcji: losowy, min. 32 znaki, np.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=dev-secret-change-me
SESSION_TTL_HOURS=12

# Hasło początkowe kont urzędników (seed tworzy tylko brakujące konta, nigdy nie nadpisuje haseł).
# Na produkcji (ENV != dev lub ustawiony COSMOS_ENDPOINT) hasło musi mieć min. 12 znaków i różnić się
# od "demo1234" — inaczej konta urzędników nie zostaną utworzone, a istniejące konta z hasłem "demo1234"
# zostaną wyłączone (flaga `disabled`, logowanie zwraca 401).
OFFICIAL_DEFAULT_PASSWORD=demo1234

# --- AI (plan 02) ---
# Bez AZURE_OPENAI_ENDPOINT i AZURE_OPENAI_API_KEY działa DemoLLM (odpowiedzi kanoniczne, offline).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
# Maks. tokenów odpowiedzi na jedno wywołanie modelu.
AI_MAX_OUTPUT_TOKENS=1500

# Limity zapytań AI (spec §14). Limiter działa w pamięci procesu (per replika).
AI_USER_RPM=20
AI_USER_DAILY=300
AI_IP_RPM=60
AI_IP_DAILY=1000
# Dzienny budżet tokenów całej aplikacji (reset o północy Europe/Warsaw, zapis w kolekcji ai_usage).
AI_DAILY_TOKENS=500000
AI_MAX_INPUT_CHARS=8000
# true tylko za zaufanym proxy (np. Azure Container Apps ingress): wtedy IP = pierwszy adres z X-Forwarded-For.
TRUST_PROXY=false
